{
  "name": "neobrutal-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prepare-build.mjs && tsx src/scripts/generate-registry-json.ts",
    "build": "shadcn build --output public/r",
    "postbuild": "node scripts/finalize-build.mjs && tsx src/scripts/sync-docs-public.ts",
    "consumer:verify": "node scripts/verify-consumer.mjs",
    "dev": "vite --host 127.0.0.1",
    "format": "oxlint --fix --no-error-on-unmatched-pattern src scripts && oxfmt --write --no-error-on-unmatched-pattern src scripts tsconfig.json tsconfig.consumer.json package.json .oxlintrc.json .oxfmtrc.json",
    "lint": "oxlint --no-error-on-unmatched-pattern src scripts && oxfmt --check --no-error-on-unmatched-pattern src scripts tsconfig.json tsconfig.consumer.json package.json .oxlintrc.json .oxfmtrc.json",
    "list": "shadcn list https://neobrutal-ui.andongmin.com/r/registry.json",
    "list:local": "shadcn list http://127.0.0.1:5177/r/registry.json",
    "registry:validate": "shadcn registry validate ./registry.json",
    "registry:check": "node scripts/check-source-ownership.mjs && node scripts/check-registry.mjs && node --test scripts/consumer-command.test.mjs",
    "registry:verify-directory": "node scripts/verify-directory.mjs",
    "registry:verify-live": "node scripts/verify-live.mjs && node scripts/verify-directory.mjs",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.consumer.json"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.24.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.81.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.9.2",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "zod": "^4.4.3"
  }
}
