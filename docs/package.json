{
  "name": "neobrutal-ui-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx src/scripts/generate-charts-ts.ts",
    "predev": "npm run generate",
    "dev": "fumapress dev",
    "prebuild": "npm run generate",
    "build": "fumapress build",
    "postbuild": "node scripts/write-build-info.mjs",
    "start": "fumapress start",
    "format": "oxlint --fix --no-error-on-unmatched-pattern app src scripts tests press.config.tsx vite.config.ts && oxfmt --write --no-error-on-unmatched-pattern app src scripts tests press.config.tsx vite.config.ts tsconfig.json package.json .oxlintrc.json .oxfmtrc.json",
    "lint": "oxlint --deny-warnings --format unix --no-error-on-unmatched-pattern app src scripts tests press.config.tsx vite.config.ts && oxfmt --check --no-error-on-unmatched-pattern app src scripts tests press.config.tsx vite.config.ts tsconfig.json package.json .oxlintrc.json .oxfmtrc.json",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/beginner-copy.test.ts scripts/build-info.test.ts scripts/docs-contract.test.ts scripts/preview-contract.test.ts scripts/template-contract.test.ts scripts/product-foundation.test.tsx scripts/chart-contract.test.ts",
    "test:browser": "playwright test",
    "test:browser:cross": "playwright test --config=playwright.cross-browser.config.ts",
    "check:budget": "node scripts/check-build-budget.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:headers": "node scripts/verify-security-headers.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "16.15.7",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.7",
    "fumapress": "1.3.1",
    "input-otp": "^1.4.2",
    "isbot": "^5.2.1",
    "lucide-react": "^1.27.0",
    "next-themes": "0.4.6",
    "pretendard": "^1.3.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.81.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/typescript6": "6.0.2",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.76.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
