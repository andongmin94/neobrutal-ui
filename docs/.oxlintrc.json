{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "unicorn", "typescript", "oxc", "jsx-a11y"],
  "ignorePatterns": [
    ".vitepress/cache/**",
    ".vitepress/dist/**",
    "node_modules/**",
    "src/components/ui/**",
    "src/components/templates/**"
  ],
  "overrides": [
    {
      "files": [
        "app/components/search-launcher.tsx",
        "src/examples/ui/combobox/**/*.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ],
  "settings": {
    "react": {
      "version": "19.2.7"
    }
  }
}
